{
  "name": "mmd-modoki",
  "productName": "MMD modoki",
  "version": "0.2.2",
  "description": "Electron desktop app for previewing and editing MMD assets",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:zip": "electron-forge make --targets @electron-forge/maker-zip",
    "make:dmg": "electron-forge make --targets @electron-forge/maker-dmg",
    "publish": "electron-forge publish",
    "generate:luts": "node scripts/generate-builtin-luts.js",
    "generate:test-models": "node scripts/generate-external-parent-test-models.mjs",
    "generate:x-test-fixtures": "node scripts/generate-x-accessory-fixtures.mjs",
    "smoke:launch": "node scripts/smoke-launch.mjs",
    "benchmark:export-rgba": "node scripts/benchmark-export-rgba.mjs",
    "test:e2e": "playwright test",
    "test:stress:png": "node scripts/run-png-export-stress.mjs",
    "log:tail": "node scripts/show-app-log.mjs --latest-session --lines 120",
    "log:errors": "node scripts/show-app-log.mjs --latest-session --level warn,error --lines 200",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "typecheck:critical": "node scripts/check-critical-type-errors.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "test:unit": "vitest run --environment node --exclude \"test/e2e/**\""
  },
  "keywords": [],
  "author": {
    "name": "togechiyo",
    "email": "togechiyo.gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "40.4.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@babylonjs/core": "9.2.0",
    "@babylonjs/gui": "9.2.0",
    "@babylonjs/loaders": "9.2.0",
    "@babylonjs/materials": "9.2.0",
    "babylon-mmd": "^1.2.0",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^25.8.18",
    "iconv-lite": "^0.7.0",
    "mediabunny": "^1.39.1"
  }
}
