# MMD_modoki OBJ loader fixture
# One unit-wide, one-unit-tall cube with no MTL or texture references.
o TofuCube
v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 1.0 -0.5
v -0.5 1.0 -0.5
v -0.5 0.0  0.5
v  0.5 0.0  0.5
v  0.5 1.0  0.5
v -0.5 1.0  0.5

vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

s off
f 5//1 6//1 7//1 8//1
f 2//2 1//2 4//2 3//2
f 6//3 2//3 3//3 7//3
f 1//4 5//4 8//4 4//4
f 8//5 7//5 3//5 4//5
f 1//6 2//6 6//6 5//6
